<?xml version="1.0" encoding="utf-8"?>
<font-family
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Regular -->
    <font
        android:font="@font/iosevka_charon_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/iosevka_charon_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />

    <!-- Italic -->
    <font
        android:font="@font/iosevka_charon_italic"
        android:fontStyle="italic"
        android:fontWeight="400"
        app:font="@font/iosevka_charon_italic"
        app:fontStyle="italic"
        app:fontWeight="400" />

    <!-- Bold -->
    <font
        android:font="@font/iosevka_charon_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/iosevka_charon_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />
</font-family>